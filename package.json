{
  "name": "pixel-papercraft-generators",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "test:generators": "playwright test",
    "test:generators:update": "playwright test --update-snapshots=all",
    "test:generators:report": "playwright show-report",
    "lint": "next lint",
    "types:check": "tsc",
    "makeTextures": "ts-node src/tools/makeTextures/makeTextures.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@heroicons/react": "2.1.3",
    "jspdf": "^4.2.1",
    "marked": "^17.0.5",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.4",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "0.5.13",
    "@types/node": "20.19.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser": "7.13.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.4",
    "imageinfo": "1.0.4",
    "jimp": "0.22.12",
    "postcss": "8.4.38",
    "prettier": "3.3.2",
    "tailwindcss": "3.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.4.5",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
